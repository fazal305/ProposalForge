# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon recommended — https://neon.tech).
# Use the pooled connection string for serverless function compatibility.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign auth JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="[REPLACE_WITH_RANDOM_SECRET]"

# OpenRouter API key for the AI Quote Assistant (https://openrouter.ai/keys).
# Educational project: this is NOT provided for you — generate your own key.
# The AI Quote Assistant feature is inert without it; nothing else depends on it.
OPENROUTER_API_KEY=""

# Base URL of the deployed app (used to build public proposal share links).
# Set to your Vercel production URL after deploying; defaults to localhost in dev.
APP_BASE_URL="http://localhost:5173"
